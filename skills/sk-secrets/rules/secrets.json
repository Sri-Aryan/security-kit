      "pattern": "(?i)\\b(echo|print|printf|cat|Write-Host|Write-Output)\\b.{0,80}(\\$\\{\\{\\s*secrets\\.|\\$\\{?[A-Z_]*(TOKEN|SECRET|KEY|PASSWORD|PASSWD|CREDENTIALS)\\b)",
