      ],
      "pattern": ".",
      "path_includes": "(?i)(\\.(pem|key|p12|pfx|jks|keystore|ppk|asc)$|(^|/)id_(rsa|dsa|ecdsa|ed25519)$|(^|/)\\.?(credentials|htpasswd|netrc|pgpass)$|(^|/)\\.aws/credentials$|serviceAccount\\w*\\.json$|(^|/)\\.npmrc$|(^|/)\\.pypirc$)",
      "path_excludes": "(?i)(public|\\.pub$|cert\\.pem$|ca\\.pem$|chain\\.pem$|fullchain)",
      "file_requires": "(?i)(PRIVATE KEY|_authToken|password|secret|aws_secret_access_key|token)",
      "confidence": "HIGH",
