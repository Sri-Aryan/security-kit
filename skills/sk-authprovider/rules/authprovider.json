      "check_id": "AUTHP-SERVER-001",
      "title": "supabase.auth.getSession() trusted on the server",
      "files": [
        "js"
      ],
      "path_includes": "(?i)(middleware\\.|proxy\\.|route\\.[cm]?[jt]s$|/server/|\\.server\\.|/api/|actions?\\.[jt]s$|/actions/|\\+page\\.server|\\+layout\\.server|\\+server\\.|hooks\\.server|loader|/lib/)",
      "pattern": "\\.auth\\.getSession\\(\\)",
      "confidence": "MEDIUM",
      "note": "On the server getSession() reads the cookie without revalidating the JWT signature against Supabase. Use auth.getUser() or auth.getClaims() for authorization decisions.",
      "examples": {
        "match": [
          "const { data: { session } } = await supabase.auth.getSession();\nif (!session) redirect('/login');"
        ],
        "no_match": [
          "const { data: { user } } = await supabase.auth.getUser();"
        ]
      }
    },
