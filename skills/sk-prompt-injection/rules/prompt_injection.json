      "check_id": "PI-SEP-001",
      "title": "System prompt built with interpolated values",
      "files": [
        "code"
      ],
      "pattern": "(?i)(['\\\"]?role['\\\"]?\\s*:\\s*['\\\"]system['\\\"][^}\\n]*['\\\"]?content['\\\"]?\\s*:\\s*(`[^`]*\\$\\{|f['\\\"][^'\\\"\\n]*\\{|['\\\"][^'\\\"\\n]*['\\\"]\\s*\\+)|\\bsystem_?(prompt|message|instruction)s?['\\\"]?\\s*[:=]\\s*(`[^`]*\\$\\{|f['\\\"][^'\\\"\\n]*\\{|['\\\"][^'\\\"\\n]*['\\\"]\\s*\\+)|\\bsystem(Prompt|Message|Instruction)s?\\s*[:=]\\s*(`[^`]*\\$\\{|['\\\"][^'\\\"\\n]*['\\\"]\\s*\\+)|SystemMessage\\(\\s*(content\\s*=\\s*)?f['\\\"]|\\bsystem\\s*:\\s*`[^`]*\\$\\{)",
      "confidence": "MEDIUM",
