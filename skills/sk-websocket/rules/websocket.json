      "id": "ws-token-in-url",
      "check_id": "WS-AUTH-001",
      "title": "Auth token passed in the WebSocket URL",
      "files": [
        "js",
        "web",
        "dart",
        "swift",
        "kt"
      ],
      "pattern": "(?i)(new\\s+WebSocket|io|connect|WebSocketChannel\\.connect|URLSessionWebSocketTask|webSocket)\\(\\s*[^\\n]*[?&](token|access_token|jwt|auth|apikey|api_key)=",
      "confidence": "LOW",
      "note": "URLs are logged by proxies and servers. Prefer a short-lived one-time ticket, a cookie, or the first message / Socket.IO auth payload.",
      "examples": {
