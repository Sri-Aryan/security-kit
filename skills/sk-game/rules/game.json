      "pattern": "OnServer(Event|Invoke)\\s*[:.]\\s*Connect\\(\\s*function\\s*\\(\\s*\\w+\\s*,\\s*\\w*({{VALUE}}|damage|health|speed|position|cframe|walkspeed)\\w*",
      "confidence": "HIGH",
      "note": "Exploiters fire RemoteEvents with any arguments. The server decides how much is earned or dealt, from its own state.",
      "examples": {
        "match": [
          "AddCoins.OnServerEvent:Connect(function(player, amount)\n  player.leaderstats.Coins.Value += amount\nend)"
        ],
        "no_match": [
          "CollectCoin.OnServerEvent:Connect(function(player, coinId)\n  if not coins[coinId] then return end\nend)"
        ]
      }
