{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/getsecuritykit/kit/skills/sk-audit/schema/report.schema.json",
  "title": "SecurityKit sk-audit combined report",
  "type": "object",
  "required": ["schemaVersion", "tool", "generatedAt", "score", "summary", "skills", "findings"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "tool": {
      "type": "object",
      "required": ["name", "skill", "version"],
      "additionalProperties": false,
      "properties": {
        "name": { "const": "SecurityKit" },
        "skill": { "const": "sk-audit" },
        "version": { "type": "string" }
      }
    },
    "generatedAt": { "type": "string", "format": "date-time" },
    "score": { "type": "integer", "minimum": 0, "maximum": 100 },
    "summary": {
      "type": "object",
      "required": ["critical", "high", "medium", "low", "skillsRun", "findingsBeforeDedup", "duplicatesMerged"],
      "additionalProperties": false,
      "properties": {
        "critical": { "type": "integer", "minimum": 0 },
        "high": { "type": "integer", "minimum": 0 },
        "medium": { "type": "integer", "minimum": 0 },
        "low": { "type": "integer", "minimum": 0 },
        "skillsRun": { "type": "integer", "minimum": 0 },
        "findingsBeforeDedup": { "type": "integer", "minimum": 0 },
        "duplicatesMerged": { "type": "integer", "minimum": 0 }
      }
    },
    "skills": {
      "type": "array",
      "description": "One row per skill report that was combined.",
      "items": {
        "type": "object",
        "required": ["skill", "file", "open"],
        "properties": {
          "skill": { "type": "string", "pattern": "^sk-[a-z0-9-]+$" },
          "file": { "type": "string" },
          "score": { "type": ["integer", "null"] },
          "generatedAt": { "type": ["string", "null"] },
          "summary": { "type": "object" },
          "open": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "severity", "title", "checkIds", "sources"],
        "properties": {
          "id": { "type": "string", "pattern": "^SK-AUDIT-[0-9]{4}$" },
          "severity": { "enum": ["Critical", "High", "Medium", "Low"] },
          "title": { "type": "string" },
          "checkIds": { "type": "array", "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9]*(-[A-Z][A-Z0-9]*)+-[0-9]{3}$" } },
          "location": { "type": ["object", "null"] },
          "request": { "type": ["object", "null"] },
          "evidence": { "type": ["string", "null"] },
          "impact": { "type": ["string", "null"] },
          "fix": { "type": ["string", "null"] },
          "regressionTest": { "type": ["string", "null"] },
          "references": { "type": ["object", "null"] },
          "sources": {
            "type": "array",
            "minItems": 1,
            "description": "The original findings merged into this one.",
            "items": {
              "type": "object",
              "required": ["skill"],
              "properties": {
                "skill": { "type": "string" },
                "id": { "type": ["string", "null"] },
                "checkId": { "type": ["string", "null"] },
                "severity": { "type": ["string", "null"] }
              }
            }
          }
        }
      }
    },
    "warnings": { "type": "array", "items": { "type": "string" } }
  }
}
